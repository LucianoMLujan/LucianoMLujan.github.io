---
import SectionDecor from "./three/SectionDecor.astro";

const education = [
	{
		title: "Licenciatura en Sistemas de la Información",
		institution: "Universidad Autónoma de Entre Ríos",
		period: "2019 — 2022",
		completed: false,
	},
	{
		title: "Ingeniería en Sistemas de la Información",
		institution: "UTN CDU",
		period: "2016 — 2019",
		completed: false,
	},
	{
		title: "Analista en Sistemas",
		institution: "Sedes Sapientiae",
		period: "2013 — 2016",
		completed: false,
	},
];

const certifications = [
	{
		title: "AI Engineering",
		provider: "Coderhouse",
		detail: "Jun 2026",
		initials: "AI",
	},
	{
		title: "Idioma — Inglés",
		provider: "Trinity 4",
		detail: "Nivel Intermedio",
		initials: "EN",
		icon: "🇺🇸",
	},
	{
		title: "Master en Desarrollo Web Full Stack",
		provider: "Udemy",
		detail: "Mar 2021 · 35 horas",
		initials: "FS",
	},
	{
		title: "Master en PHP, SQL y Laravel",
		provider: "Udemy",
		detail: "Jul 2020 · 56.5 horas",
		initials: "PHP",
	},
];
---

<section id="educacion" class="relative overflow-hidden py-20 md:py-28">
	<!-- Background -->
	<div
		class="absolute inset-0 bg-gradient-to-b from-base/80 via-surface/20 to-base/80"
		aria-hidden="true"></div>
	<div
		class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-accent/5 via-transparent to-transparent"
		aria-hidden="true"></div>

	<SectionDecor
		variant="knowledge"
		class="-top-10 right-0 h-[18rem] w-[18rem] opacity-40 md:h-[24rem] md:w-[24rem] lg:h-[30rem] lg:w-[30rem] lg:opacity-50"
	/>

	<div class="relative mx-auto max-w-5xl px-5">
		<header class="mb-12" data-reveal>
			<p
				class="mb-3 inline-block rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1 text-xs font-medium tracking-wide text-accent-soft uppercase backdrop-blur-sm"
			>
				Formación
			</p>
			<h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
				<span class="gradient-text">Educación y certificaciones</span>
			</h2>
			<p class="mt-4 max-w-xl text-sm text-muted md:text-base">
				Formación académica y certificaciones que respaldan mi perfil técnico.
			</p>
			<span
				class="mt-5 block h-px w-28 bg-gradient-to-r from-accent via-sky-400 to-transparent"
				aria-hidden="true"></span>
		</header>

		<div class="grid items-stretch gap-8 md:grid-cols-2">
			<!-- Education column -->
			<div class="flex flex-col gap-4">
				<div class="flex items-center justify-between gap-2">
					<h3
						class="font-display text-sm font-semibold tracking-wide text-accent-soft uppercase"
					>
						Educación
					</h3>
					<span class="counter">
						{String(education.length).padStart(2, "0")}
					</span>
				</div>

				{education.map((item, i) => (
					<div
						class="flex flex-1"
						data-reveal
						style={`--reveal-delay: ${i * 80}ms`}
					>
						<article
							class="edu-card group relative w-full overflow-hidden rounded-2xl border border-line/40 bg-surface/30 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-surface/50"
							data-glow
						>
							<span
								class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 font-display text-5xl font-bold text-white/[0.04] select-none"
								aria-hidden="true"
							>
								{String(i + 1).padStart(2, "0")}
							</span>

							<span
								class="absolute inset-y-5 left-0 w-px bg-gradient-to-b from-accent/70 via-sky-400/30 to-transparent"
								aria-hidden="true"
							></span>

							<div class="relative z-10 flex h-full flex-col justify-between gap-4">
								<div class="flex items-start gap-3">
									<span class="edu-icon" aria-hidden="true">
										<svg
											class="h-5 w-5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
											/>
										</svg>
									</span>

									<div class="min-w-0 flex-1">
										<h4 class="font-display font-semibold leading-tight text-white">
											{item.title}
										</h4>
										<p class="mt-1 text-sm text-accent-soft">
											{item.institution}
										</p>
									</div>
								</div>

								<div class="flex flex-wrap items-center justify-between gap-2 border-t border-line/30 pt-3">
									<p class="font-display text-xs tracking-wide text-muted">
										{item.period}
									</p>
									<span
										class={`status ${item.completed ? "status-complete" : "status-progress"}`}
									>
										{item.completed ? "Completado" : "Incompleto"}
									</span>
								</div>
							</div>
						</article>
					</div>
				))}
			</div>

			<!-- Certifications column -->
			<div class="flex flex-col gap-4">
				<div class="flex items-center justify-between gap-2">
					<h3
						class="font-display text-sm font-semibold tracking-wide text-accent-soft uppercase"
					>
						Certificaciones
					</h3>
					<span class="counter">
						{String(certifications.length).padStart(2, "0")}
					</span>
				</div>

				{certifications.map((item, i) => (
					<div
						class="flex flex-1"
						data-reveal
						style={`--reveal-delay: ${(i + education.length) * 80}ms`}
					>
						<article
							class="cert-card group relative w-full overflow-hidden rounded-2xl border border-line/40 bg-surface/30 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-surface/50"
							data-glow
						>
							<div class="relative z-10 flex h-full flex-col justify-between gap-4">
								<div class="flex items-start gap-3">
									<span class="seal" aria-hidden="true">
										<span>{item.initials}</span>
									</span>

									<div class="min-w-0 flex-1">
										<span class="provider-chip">
											{item.icon && (
												<span class="text-sm leading-none">{item.icon}</span>
											)}
											{item.provider}
										</span>
										<h4 class="font-display font-semibold leading-tight text-white">
											{item.title}
										</h4>
									</div>
								</div>

								<div class="flex flex-wrap items-center justify-between gap-2 border-t border-line/30 pt-3">
									<p class="text-xs text-muted">{item.detail}</p>
									<span class="verified">
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="m4.5 12.75 6 6 9-13.5"
											/>
										</svg>
										Certificado
									</span>
								</div>
							</div>
						</article>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.counter {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		border-radius: 9999px;
		border: 1px solid var(--color-line);
		padding: 0.1rem 0.5rem;
		font-family: var(--font-display);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		color: #6f6f83;
	}

	.edu-icon {
		display: grid;
		place-items: center;
		height: 2.5rem;
		width: 2.5rem;
		flex: none;
		border-radius: 0.9rem;
		border: 1px solid rgba(167, 139, 250, 0.3);
		background: linear-gradient(
			145deg,
			rgba(139, 92, 246, 0.22),
			rgba(18, 18, 26, 0.4)
		);
		box-shadow: inset 0 0 16px rgba(139, 92, 246, 0.15);
		color: #c4b5fd;
		transition: transform 0.3s ease;
	}

	.edu-card:hover .edu-icon {
		transform: rotate(-6deg) scale(1.05);
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		border-radius: 9999px;
		padding: 0.15rem 0.55rem;
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.status-progress {
		border: 1px solid rgba(251, 191, 36, 0.22);
		background: rgba(251, 191, 36, 0.08);
		color: #fcd34d;
	}

	.status-complete {
		border: 1px solid rgba(52, 211, 153, 0.22);
		background: rgba(52, 211, 153, 0.08);
		color: #6ee7b7;
	}

	.provider-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-bottom: 0.45rem;
		border-radius: 9999px;
		border: 1px solid rgba(167, 139, 250, 0.2);
		background: rgba(139, 92, 246, 0.1);
		padding: 0.15rem 0.55rem;
		font-size: 0.625rem;
		font-weight: 500;
		color: #c4b5fd;
	}

	.seal {
		position: relative;
		display: grid;
		place-items: center;
		height: 2.75rem;
		width: 2.75rem;
		flex: none;
		border-radius: 9999px;
		border: 1px solid rgba(167, 139, 250, 0.35);
		background: radial-gradient(
			circle at 30% 20%,
			rgba(139, 92, 246, 0.4),
			rgba(18, 18, 26, 0.85) 72%
		);
		box-shadow: inset 0 0 14px rgba(139, 92, 246, 0.25);
		font-family: var(--font-display);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: #ddd6fe;
	}

	.seal::before {
		content: "";
		position: absolute;
		inset: -5px;
		border-radius: inherit;
		border: 1px dashed rgba(167, 139, 250, 0.35);
	}

	.cert-card:hover .seal::before {
		animation: seal-spin 10s linear infinite;
	}

	.verified {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		border-radius: 9999px;
		border: 1px solid rgba(52, 211, 153, 0.22);
		background: rgba(52, 211, 153, 0.08);
		padding: 0.15rem 0.55rem;
		font-size: 0.625rem;
		font-weight: 500;
		color: #6ee7b7;
	}

	.verified svg {
		height: 0.75rem;
		width: 0.75rem;
	}

	@keyframes seal-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.edu-card:hover .edu-icon {
			transform: none;
		}

		.cert-card:hover .seal::before {
			animation: none;
		}
	}
</style>
