---
/**
 * Fondo global: una red de nodos 3D (como un grafo de dependencias) con
 * habilidades técnicas flotando. Es tenue para no competir con el contenido.
 */
---

<div
	class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
	aria-hidden="true"
>
	<canvas
		data-code-network
		class="h-full w-full opacity-0 transition-opacity duration-1000"
	></canvas>
</div>

<script>
	import * as THREE from "three";
	import { createGlyphSprite } from "../../lib/three/glyphs";
	import { skills } from "../../lib/skills";
	import {
		hasWebGLSupport,
		initBackground2D,
		mount2DFallback,
	} from "../../lib/three/fallback2d";

	const canvas = document.querySelector<HTMLCanvasElement>(
		"[data-code-network]",
	);

	if (canvas) initCodeNetwork(canvas);

	function initCodeNetwork(canvas: HTMLCanvasElement) {
		if (!hasWebGLSupport()) {
			console.warn(
				"[three] WebGL no disponible; se usa la animación 2D de respaldo.",
			);
			initBackground2D(mount2DFallback(canvas));
			return;
		}

		let renderer: THREE.WebGLRenderer;
		try {
			renderer = new THREE.WebGLRenderer({
				canvas,
				alpha: true,
				antialias: false,
				powerPreference: "low-power",
			});
		} catch (error) {
			// Sin WebGL se usa un respaldo animado con Canvas 2D.
			console.warn(
				"[three] WebGL no disponible; se usa la animación 2D de respaldo.",
				error,
			);
			initBackground2D(mount2DFallback(canvas));
			return;
		}

		const reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		const isCompact = window.innerWidth < 768;

		renderer.setPixelRatio(
			Math.min(window.devicePixelRatio, isCompact ? 1.25 : 1.6),
		);
		renderer.setClearColor(0x000000, 0);

		const scene = new THREE.Scene();
		scene.fog = new THREE.FogExp2(0x0a0a0f, 0.022);

		const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
		camera.position.set(0, 0, 22);

		const network = new THREE.Group();
		scene.add(network);

		// --- Nodos ---
		const nodeCount = isCompact ? 34 : 68;
		const spread = isCompact ? { x: 14, y: 20, z: 10 } : { x: 32, y: 26, z: 14 };
		const nodes: THREE.Vector3[] = [];
		const nodePositions = new Float32Array(nodeCount * 3);

		for (let i = 0; i < nodeCount; i++) {
			const node = new THREE.Vector3(
				(Math.random() - 0.5) * spread.x,
				(Math.random() - 0.5) * spread.y,
				(Math.random() - 0.5) * spread.z,
			);
			nodes.push(node);
			node.toArray(nodePositions, i * 3);
		}

		const nodeGeometry = new THREE.BufferGeometry();
		nodeGeometry.setAttribute(
			"position",
			new THREE.BufferAttribute(nodePositions, 3),
		);

		const nodePoints = new THREE.Points(
			nodeGeometry,
			new THREE.PointsMaterial({
				color: 0x8b5cf6,
				size: isCompact ? 0.22 : 0.17,
				transparent: true,
				opacity: 0.45,
				sizeAttenuation: true,
				depthWrite: false,
				blending: THREE.AdditiveBlending,
			}),
		);
		network.add(nodePoints);

		// --- Conexiones (cada nodo con sus vecinos más cercanos) ---
		const linkPositions: number[] = [];
		const linked = new Set<string>();
		const maxDistance = 7.5;

		nodes.forEach((node, index) => {
			const nearest = nodes
				.map((candidate, candidateIndex) => ({
					candidateIndex,
					distance: node.distanceTo(candidate),
				}))
				.filter(
					({ candidateIndex, distance }) =>
						candidateIndex !== index && distance < maxDistance,
				)
				.sort((a, b) => a.distance - b.distance)
				.slice(0, isCompact ? 1 : 2);

			for (const { candidateIndex } of nearest) {
				const key =
					index < candidateIndex
						? `${index}-${candidateIndex}`
						: `${candidateIndex}-${index}`;
				if (linked.has(key)) continue;
				linked.add(key);

				const other = nodes[candidateIndex];
				linkPositions.push(
					node.x,
					node.y,
					node.z,
					other.x,
					other.y,
					other.z,
				);
			}
		});

		const linkGeometry = new THREE.BufferGeometry();
		linkGeometry.setAttribute(
			"position",
			new THREE.Float32BufferAttribute(linkPositions, 3),
		);

		const linkLines = new THREE.LineSegments(
			linkGeometry,
			new THREE.LineBasicMaterial({
				color: 0x60a5fa,
				transparent: true,
				opacity: 0.1,
				depthWrite: false,
				blending: THREE.AdditiveBlending,
			}),
		);
		network.add(linkLines);

		// --- Habilidades técnicas flotando ---
		const skillLabels = skills.map((skill) => skill.name);
		const palette = ["#a78bfa", "#60a5fa", "#34d399"];
		const glyphs: {
			sprite: THREE.Sprite;
			baseX: number;
			speed: number;
			sway: number;
			phase: number;
		}[] = [];

		const glyphCount = isCompact ? 5 : 7;
		for (let i = 0; i < glyphCount; i++) {
			const label =
				skillLabels[Math.floor((i * skillLabels.length) / glyphCount)];

			const sprite = createGlyphSprite(
				label,
				palette[i % palette.length],
				0.42 + Math.random() * 0.22,
			);
			const material = sprite.material as THREE.SpriteMaterial;
			material.opacity = 0.14;

			sprite.position.set(
				(Math.random() - 0.5) * spread.x * 0.9,
				(Math.random() - 0.5) * spread.y * 0.9,
				(Math.random() - 0.5) * spread.z * 0.6,
			);
			network.add(sprite);

			glyphs.push({
				sprite,
				baseX: sprite.position.x,
				speed: 0.25 + Math.random() * 0.4,
				sway: 0.35 + Math.random() * 0.7,
				phase: Math.random() * Math.PI * 2,
			});
		}

		if (isCompact) network.scale.setScalar(0.72);

		// --- Interacción ---
		const pointer = new THREE.Vector2();
		const targetPointer = new THREE.Vector2();

		window.addEventListener(
			"pointermove",
			(event) => {
				targetPointer.set(
					(event.clientX / window.innerWidth) * 2 - 1,
					(event.clientY / window.innerHeight) * 2 - 1,
				);
			},
			{ passive: true },
		);

		// --- Ciclo de render ---
		const timer = new THREE.Timer();
		timer.connect(document);
		let elapsed = 0;
		let frameId = 0;
		let inView = true;
		let pageHidden = document.hidden;

		const canAnimate = () =>
			!reducedMotion && inView && !pageHidden;

		function resize() {
			const width = window.innerWidth;
			const height = window.innerHeight;
			renderer.setSize(width, height, false);
			camera.aspect = width / height;
			camera.updateProjectionMatrix();
		}

		function renderFrame(timestamp?: number) {
			frameId = 0;
			timer.update(timestamp);
			const delta = Math.min(timer.getDelta(), 0.05);
			elapsed += delta;

			pointer.lerp(targetPointer, 0.035);

			network.rotation.y = elapsed * 0.02 + pointer.x * 0.16;
			network.rotation.x = Math.sin(elapsed * 0.08) * 0.05 + pointer.y * 0.1;

			camera.position.x = pointer.x * 1.6;
			camera.position.y = -pointer.y * 1.1;
			camera.lookAt(0, 0, 0);

			for (const glyph of glyphs) {
				glyph.sprite.position.y += glyph.speed * delta;
				if (glyph.sprite.position.y > spread.y * 0.55) {
					glyph.sprite.position.y = -spread.y * 0.55;
				}
				glyph.sprite.position.x =
					glyph.baseX + Math.sin(elapsed * 0.35 + glyph.phase) * glyph.sway;
			}

			renderer.render(scene, camera);

			if (canAnimate()) frameId = requestAnimationFrame(renderFrame);
		}

		function start() {
			if (!frameId && canAnimate()) {
				frameId = requestAnimationFrame(renderFrame);
			}
		}

		function stop() {
			if (frameId) {
				cancelAnimationFrame(frameId);
				frameId = 0;
			}
		}

		const observer = new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				if (inView) start();
				else stop();
			},
			{ threshold: 0 },
		);
		observer.observe(canvas);

		document.addEventListener("visibilitychange", () => {
			pageHidden = document.hidden;
			if (pageHidden) stop();
			else start();
		});

		window.addEventListener("resize", () => {
			resize();
			if (reducedMotion) renderer.render(scene, camera);
		});

		resize();
		renderer.render(scene, camera);
		canvas.classList.remove("opacity-0");
		canvas.classList.add("opacity-100");
		start();
	}
</script>
