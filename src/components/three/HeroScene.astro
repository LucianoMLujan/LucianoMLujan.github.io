---
/**
 * Escena 3D del hero: un núcleo wireframe (como un render en construcción)
 * rodeado de anillos y habilidades técnicas en órbita. Reacciona al puntero.
 */
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true">
	<canvas
		data-hero-canvas
		class="block h-full w-full opacity-0 transition-opacity duration-[1400ms]"
	></canvas>
</div>

<script>
	import * as THREE from "three";
	import { createGlyphSprite } from "../../lib/three/glyphs";
	import { skills } from "../../lib/skills";
	import {
		hasWebGLSupport,
		initHero2D,
		mount2DFallback,
	} from "../../lib/three/fallback2d";

	const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]");

	if (canvas) initHeroScene(canvas);

	function initHeroScene(canvas: HTMLCanvasElement) {
		const host = canvas.parentElement;
		if (!host) return;

		if (!hasWebGLSupport()) {
			console.warn(
				"[three] WebGL no disponible; se usa la animación 2D de respaldo.",
			);
			initHero2D(mount2DFallback(canvas));
			return;
		}

		let renderer: THREE.WebGLRenderer;
		try {
			renderer = new THREE.WebGLRenderer({
				canvas,
				alpha: true,
				antialias: true,
				powerPreference: "high-performance",
			});
		} catch (error) {
			// Sin WebGL se usa un respaldo animado con Canvas 2D.
			console.warn(
				"[three] WebGL no disponible; se usa la animación 2D de respaldo.",
				error,
			);
			initHero2D(mount2DFallback(canvas));
			return;
		}

		const reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		const isCompact = window.innerWidth < 768;

		renderer.setPixelRatio(
			Math.min(window.devicePixelRatio, isCompact ? 1.5 : 2),
		);
		renderer.setClearColor(0x000000, 0);
		renderer.outputColorSpace = THREE.SRGBColorSpace;

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);

		const rig = new THREE.Group();
		scene.add(rig);

		const violet = 0x8b5cf6;
		const cyan = 0x60a5fa;

		// Núcleo: malla wireframe, como un objeto 3D recién renderizado.
		const coreGroup = new THREE.Group();
		rig.add(coreGroup);

		const coreGeometry = new THREE.IcosahedronGeometry(2.15, 1);
		const core = new THREE.LineSegments(
			new THREE.EdgesGeometry(coreGeometry),
			new THREE.LineBasicMaterial({
				color: violet,
				transparent: true,
				opacity: 0.32,
				depthWrite: false,
				blending: THREE.AdditiveBlending,
			}),
		);
		coreGroup.add(core);

		const coreVertices = new THREE.Points(
			coreGeometry,
			new THREE.PointsMaterial({
				color: 0xa78bfa,
				size: 0.085,
				transparent: true,
				opacity: 0.85,
				sizeAttenuation: true,
				depthWrite: false,
				blending: THREE.AdditiveBlending,
			}),
		);
		coreGroup.add(coreVertices);

		// Octaedro interno girando en sentido contrario.
		const inner = new THREE.LineSegments(
			new THREE.EdgesGeometry(new THREE.OctahedronGeometry(1.05, 0)),
			new THREE.LineBasicMaterial({
				color: cyan,
				transparent: true,
				opacity: 0.42,
				depthWrite: false,
				blending: THREE.AdditiveBlending,
			}),
		);
		rig.add(inner);

		// Anillos orbitales.
		const createRing = (radius: number, color: number, opacity: number) => {
			const curve = new THREE.EllipseCurve(0, 0, radius, radius, 0, Math.PI * 2);
			const points = curve
				.getPoints(140)
				.map((point) => new THREE.Vector3(point.x, point.y, 0));
			const geometry = new THREE.BufferGeometry().setFromPoints(points);
			return new THREE.LineLoop(
				geometry,
				new THREE.LineBasicMaterial({
					color,
					transparent: true,
					opacity,
					depthWrite: false,
					blending: THREE.AdditiveBlending,
				}),
			);
		};

		const ringA = createRing(3.05, cyan, 0.16);
		ringA.rotation.set(Math.PI / 2.6, 0.3, 0);
		rig.add(ringA);

		const ringB = createRing(3.7, violet, 0.1);
		ringB.rotation.set(Math.PI / 1.9, 0, 0.4);
		rig.add(ringB);

		// Habilidades técnicas orbitando en planos aleatorios.
		const skillLabels = skills.map((skill) => skill.name);
		const palette = ["#a78bfa", "#60a5fa", "#34d399"];
		const glyphs: {
			orbit: THREE.Group;
			sprite: THREE.Sprite;
			angle: number;
			speed: number;
			radius: number;
			bob: number;
		}[] = [];

		const glyphCount = isCompact ? 7 : 12;
		for (let i = 0; i < glyphCount; i++) {
			const orbit = new THREE.Group();
			orbit.rotation.set(
				Math.random() * Math.PI,
				Math.random() * Math.PI * 2,
				Math.random() * Math.PI,
			);

			// Se reparten las habilidades a lo largo de la lista completa.
			const label =
				skillLabels[Math.floor((i * skillLabels.length) / glyphCount)];

			const sprite = createGlyphSprite(
				label,
				palette[i % palette.length],
				isCompact ? 0.5 : 0.44,
			);
			(sprite.material as THREE.SpriteMaterial).opacity = 0.36;
			orbit.add(sprite);
			rig.add(orbit);

			const radius = 3.3 + Math.random() * 1.1;
			const angle = Math.random() * Math.PI * 2;
			const bob = Math.random() * Math.PI * 2;

			sprite.position.set(
				Math.cos(angle) * radius,
				Math.sin(angle * 0.8 + bob) * 0.35,
				Math.sin(angle) * radius,
			);

			glyphs.push({
				orbit,
				sprite,
				angle,
				speed: 0.16 + Math.random() * 0.24,
				radius,
				bob,
			});
		}

		// Polvo de partículas alrededor de la escena.
		const dustCount = isCompact ? 160 : 320;
		const dustPositions = new Float32Array(dustCount * 3);
		for (let i = 0; i < dustCount * 3; i += 3) {
			const radius = 4 + Math.random() * 5;
			const theta = Math.random() * Math.PI * 2;
			const phi = Math.acos(2 * Math.random() - 1);
			dustPositions[i] = radius * Math.sin(phi) * Math.cos(theta);
			dustPositions[i + 1] = radius * Math.sin(phi) * Math.sin(theta);
			dustPositions[i + 2] = radius * Math.cos(phi) * 0.6;
		}

		const dustGeometry = new THREE.BufferGeometry();
		dustGeometry.setAttribute(
			"position",
			new THREE.BufferAttribute(dustPositions, 3),
		);

		const dust = new THREE.Points(
			dustGeometry,
			new THREE.PointsMaterial({
				color: 0xa78bfa,
				size: 0.035,
				transparent: true,
				opacity: 0.5,
				sizeAttenuation: true,
				depthWrite: false,
				blending: THREE.AdditiveBlending,
			}),
		);
		scene.add(dust);

		// --- Cámara: encaja la escena completa en cualquier relación de aspecto ---
		const fitRadius = 4.35;

		function resize() {
			const width = host.clientWidth;
			const height = host.clientHeight;
			if (!width || !height) return;

			renderer.setSize(width, height, false);
			camera.aspect = width / height;

			const verticalFov = THREE.MathUtils.degToRad(camera.fov);
			camera.position.z =
				(fitRadius / (Math.tan(verticalFov / 2) * Math.min(1, camera.aspect))) *
				1.06;
			camera.updateProjectionMatrix();
		}

		// --- Puntero ---
		const pointer = new THREE.Vector2();
		const targetPointer = new THREE.Vector2();

		window.addEventListener(
			"pointermove",
			(event) => {
				targetPointer.set(
					(event.clientX / window.innerWidth) * 2 - 1,
					(event.clientY / window.innerHeight) * 2 - 1,
				);
			},
			{ passive: true },
		);

		// --- Ciclo de render ---
		const timer = new THREE.Timer();
		timer.connect(document);
		let elapsed = 0;
		let frameId = 0;
		let inView = true;
		let pageHidden = document.hidden;

		const canAnimate = () => !reducedMotion && inView && !pageHidden;

		function renderFrame(timestamp?: number) {
			frameId = 0;
			timer.update(timestamp);
			const delta = Math.min(timer.getDelta(), 0.05);
			elapsed += delta;

			pointer.lerp(targetPointer, 0.04);

			rig.rotation.y = elapsed * 0.11 + pointer.x * 0.2;
			rig.rotation.x = Math.sin(elapsed * 0.24) * 0.06 - pointer.y * 0.14;

			coreGroup.rotation.y = elapsed * 0.09;
			coreGroup.rotation.z = elapsed * 0.03;
			inner.rotation.y = -elapsed * 0.34;
			inner.rotation.x = elapsed * 0.18;

			ringA.rotation.z = elapsed * 0.05;
			ringB.rotation.y = -elapsed * 0.04;
			dust.rotation.y = elapsed * 0.015;

			for (const glyph of glyphs) {
				glyph.angle += glyph.speed * delta;
				glyph.sprite.position.set(
					Math.cos(glyph.angle) * glyph.radius,
					Math.sin(glyph.angle * 0.8 + glyph.bob) * 0.35,
					Math.sin(glyph.angle) * glyph.radius,
				);
			}

			renderer.render(scene, camera);

			if (canAnimate()) frameId = requestAnimationFrame(renderFrame);
		}

		function start() {
			if (!frameId && canAnimate()) {
				frameId = requestAnimationFrame(renderFrame);
			}
		}

		function stop() {
			if (frameId) {
				cancelAnimationFrame(frameId);
				frameId = 0;
			}
		}

		const observer = new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				if (inView) start();
				else stop();
			},
			{ threshold: 0 },
		);
		observer.observe(host);

		document.addEventListener("visibilitychange", () => {
			pageHidden = document.hidden;
			if (pageHidden) stop();
			else start();
		});

		new ResizeObserver(() => {
			resize();
			if (reducedMotion) renderer.render(scene, camera);
		}).observe(host);

		window.addEventListener("resize", () => {
			resize();
			if (reducedMotion) renderer.render(scene, camera);
		});

		resize();
		renderer.render(scene, camera);
		canvas.classList.remove("opacity-0");
		canvas.classList.add("opacity-100");
		start();
	}
</script>
