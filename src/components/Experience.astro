---
import SectionDecor from "./three/SectionDecor.astro";

interface Job {
	role: string;
	company: string;
	initials: string;
	period: string;
	current?: boolean;
	points: string[];
}

const jobs: Job[] = [
	{
		role: "Desarrollador Full Stack",
		company: "Don Web",
		initials: "DW",
		period: "Abr 2025 — Actualidad",
		current: true,
		points: [],
	},
	{
		role: "Desarrollador Full Stack",
		company: "Hotel Manager",
		initials: "HM",
		period: "Abr 2022 — Mar 2025",
		points: [],
	},
	{
		role: "Desarrollador Full Stack",
		company: "REBrit S.R.L.",
		initials: "REB",
		period: "May 2021 — Abr 2022",
		points: [],
	},
	{
		role: "Desarrollador Freelancer PHP",
		company: "Freelance",
		initials: "FL",
		period: "Mar 2019",
		points: [],
	},
	{
		role: "Programador Junior",
		company: "ITSynch S.R.L.",
		initials: "ITS",
		period: "Abr 2016 — Dic 2016",
		points: [],
	},
	{
		role: "Programador Junior",
		company: "Galbop S.R.L.",
		initials: "GS",
		period: "Ago 2015 — Mar 2016",
		points: [],
	},
	{
		role: "Programador Junior",
		company: "Pirámide Technologies",
		initials: "PT",
		period: "Ene 2014 — Jul 2015",
		points: [],
	},
];

const accents = [
	"#a78bfa",
	"#60a5fa",
	"#34d399",
	"#f472b6",
	"#fbbf24",
	"#38bdf8",
	"#c084fc",
];

const firstYear = jobs.at(-1)?.period.match(/\d{4}/)?.[0] ?? "";

const timeline = jobs.map((job, index) => {
	const [start, end] = job.period.split(" — ");
	return {
		...job,
		start,
		end,
		accent: accents[index % accents.length],
	};
});
---

<section id="experiencia" class="relative overflow-hidden">
	<SectionDecor
		variant="trajectory"
		class="-top-6 right-0 h-[20rem] w-[20rem] opacity-40 md:h-[26rem] md:w-[26rem] lg:h-[30rem] lg:w-[30rem] lg:opacity-50"
	/>

	<div class="relative mx-auto max-w-5xl px-5 py-20 md:py-28">
		<header
			class="mb-12 flex flex-wrap items-end justify-between gap-6"
			data-reveal
		>
			<div>
				<p
					class="mb-3 inline-block rounded-full border border-line bg-surface px-3.5 py-1 text-xs font-medium tracking-wide text-accent-soft uppercase"
				>
					Trayectoria
				</p>
				<h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
					<span class="gradient-text">Experiencia profesional</span>
				</h2>
				<span
					class="mt-4 block h-px w-28 bg-gradient-to-r from-accent via-sky-400 to-transparent"
					aria-hidden="true"></span>
			</div>
			<p class="text-sm text-muted">
				<span class="font-display text-2xl font-semibold text-white">
					{jobs.length}
				</span>
				<span class="ml-2 align-middle">
					etapas{firstYear && ` · ${firstYear} — hoy`}
				</span>
			</p>
		</header>

		<div class="relative">
			<span
				class="absolute top-3 bottom-3 left-[4px] w-[2px] rounded-full bg-line/70 md:left-[102px]"
				data-scroll-progress
				aria-hidden="true"
			>
				<span
					data-scroll-progress-fill
					class="block h-full w-full origin-top scale-y-0 rounded-full bg-gradient-to-b from-accent via-sky-400 to-emerald-400 shadow-[0_0_12px_rgba(139,92,246,0.55)]"
				></span>
			</span>

			<ol class="space-y-6 md:space-y-8">
				{timeline.map((job, i) => (
					<li
						class="relative pl-8 md:pl-0"
						data-reveal
						style={`--reveal-delay: ${i * 80}ms; --job-accent: ${job.accent}`}
					>
						<span
							class="absolute top-6 left-[5px] z-10 -translate-x-1/2 md:left-[103px]"
							aria-hidden="true"
						>
							<span
								class={`relative flex h-3 w-3 items-center justify-center rounded-full ring-4 ring-base ${
									job.current ? "bg-emerald-400" : "bg-accent"
								}`}
							>
								{job.current && (
									<span class="absolute inset-0 -z-10 animate-ping rounded-full bg-emerald-400/70 motion-reduce:animate-none"></span>
								)}
							</span>
						</span>

						<div class="md:flex">
							<div class="mb-2 md:mb-0 md:w-[104px] md:flex-none md:pt-4 md:pr-6 md:text-right">
								<p class="font-display text-xs font-medium tracking-wide text-muted">
									{job.start}
								</p>
								{job.end && (
									<p
										class={`text-[11px] tracking-wide ${
											job.current ? "text-emerald-300" : "text-muted/60"
										}`}
									>
										— {job.end}
									</p>
								)}
							</div>

							<article
								class="job-card group relative flex-1 overflow-hidden rounded-2xl border border-line/40 bg-surface/30 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-surface/50 md:ml-8"
								data-glow
							>
								<div class="relative z-10 flex items-start gap-4">
									<span class="job-monogram" aria-hidden="true">
										{job.initials}
									</span>

									<div class="min-w-0 flex-1">
										<h3 class="font-display text-lg font-semibold leading-tight text-white">
											{job.role}
										</h3>
										<p class="mt-0.5 text-sm text-accent-soft">{job.company}</p>

										{job.points.length > 0 && (
											<ul class="mt-3 space-y-1.5">
												{job.points.map((point) => (
													<li class="flex gap-2 text-sm leading-relaxed text-muted">
														<span class="mt-2 text-accent" aria-hidden="true">
															•
														</span>
														<span>{point}</span>
													</li>
												))}
											</ul>
										)}
									</div>

									<span
										class="hidden shrink-0 font-display text-xs tracking-widest text-muted/60 sm:block"
										aria-hidden="true"
									>
										{String(jobs.length - i).padStart(2, "0")}
									</span>
								</div>
							</article>
						</div>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.job-card::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
		background: linear-gradient(
			180deg,
			var(--job-accent, #8b5cf6),
			transparent
		);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.job-card:hover::before {
		opacity: 1;
	}

	.job-monogram {
		display: grid;
		place-items: center;
		height: 2.75rem;
		width: 2.75rem;
		flex: none;
		border-radius: 0.9rem;
		border: 1px solid
			color-mix(in srgb, var(--job-accent, #8b5cf6) 35%, transparent);
		background: linear-gradient(
			150deg,
			color-mix(in srgb, var(--job-accent, #8b5cf6) 22%, transparent),
			rgba(18, 18, 26, 0.4)
		);
		box-shadow: inset 0 0 18px
			color-mix(in srgb, var(--job-accent, #8b5cf6) 12%, transparent);
		color: color-mix(in srgb, var(--job-accent, #8b5cf6) 70%, white);
		font-family: var(--font-display);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.job-card:hover .job-monogram {
		transform: translateY(-1px) rotate(-3deg) scale(1.04);
		box-shadow: 0 0 22px
			color-mix(in srgb, var(--job-accent, #8b5cf6) 28%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.job-card:hover .job-monogram {
			transform: none;
		}
	}
</style>
